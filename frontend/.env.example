# URL base de la API.
#
# En Netlify el frontend y el backend viven en el mismo dominio, asi que
# basta con la ruta relativa: el navegador la resuelve contra el propio sitio
# y no hay que configurar CORS.
VITE_API_URL=/api

# Para desarrollo local, con el backend corriendo aparte:
# VITE_API_URL=http://localhost:5000/api
